{
  "name": "mishwark-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:local": "wrangler d1 execute mishwark-db --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute mishwark-db --remote --file=./db/schema.sql",
    "check": "find functions public -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "devDependencies": { "wrangler": "^4.45.0" }
}
